# --- Обязательное ---
BOT_TOKEN=123456:AA...                  # токен от @BotFather

# --- Webhook (для прода) ---
# Если пусто — бот запустится в long polling (удобно при локальной разработке).
WEBHOOK_URL=                            # напр. https://nailbot.example.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=                         # Telegram secret_token; обязателен на проде
PORT=8080

# --- Контент ---
KNOWLEDGE_PATH=knowledge.md

# --- Хранилище состояний ---
# Если пусто — состояния хранятся в памяти процесса (теряются при рестарте).
REDIS_URL=                              # напр. redis://localhost:6379/0

# --- SQLite CRM (записи, карточки) ---
# На Render free диск эфемерный: задайте путь на Persistent Disk, иначе
# data/nailbot.db может обнулиться при redeploy.
# Пример: DATABASE_PATH=/var/data/nailbot.db
DATABASE_PATH=

# --- P0: правда слотов (Postgres). Без URL бот как раньше (SQLite+Calendar). ---
# docker compose up -d postgres
# alembic upgrade head
DATABASE_URL=postgresql+psycopg://nailbot:nailbot@localhost:5432/nailbot
HOLD_MINUTES=5
PREPAY=false
GOOGLE_ENABLED=true
TZ=Europe/Moscow
NOSHOW_GRACE_MIN=15
CANCEL_WINDOW_H=12

# --- LLM (опционально) ---
# Если ключ не задан — бот работает только на парсере, без вызовов LLM.
# LLM_PROVIDER=groq|deepseek|openai|openrouter|vsegpt
# LLM_API_KEY / GROQ_API_KEY, LLM_BASE_URL, LLM_MODEL_PARSER, LLM_MODEL_ORACLE,
# LLM_MODEL_SUMMARY, LLM_FALLBACK_MODEL
GROQ_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LLM_PROVIDER=groq
LLM_MODEL_PARSER=
LLM_MODEL_ORACLE=
LLM_MODEL_SUMMARY=

# --- Google Calendar (JSON сервисного аккаунта одной строкой) ---
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Админы (для /reload, /backup) ---
# Список Telegram user_id через запятую. Узнать ID — @userinfobot.
ADMIN_IDS=

# --- Free tier (Render 512MB / 0.1 CPU) ---
# LEAN_MODE=1 (по умолчанию): 1 поток waitress, telebot без thread pool,
# digests off, sync calendar 2ч, oracle не грузится если oracle:no в knowledge.
LEAN_MODE=1

# --- Логи / Sentry (на free лучше пусто — меньше RAM) ---
LOG_LEVEL=INFO
SENTRY_DSN=
